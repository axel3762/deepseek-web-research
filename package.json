{
  "name": "@deepseek-ai/dsh-plugin-web-research",
  "private": true,
  "version": "1.0.0",
  "description": "Production-quality web research plugin for DeepSeek Harness with multi-provider search, secure fetching, and HTML extraction",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/plugin.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "watch": "tsc --build tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint": "eslint src/ tests/",
    "clean": "rm -rf lib node_modules .turbo"
  },
  "files": [
    "lib",
    "!lib/**/*.map"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "deepseek-web-research"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "@types/node": "^22.x",
    "typescript": "^5.6.x",
    "vitest": "^2.x"
  }
}
